# Copy to .env for local runs (the server copy lives at /opt/utils/.env, chmod 600).
# NEVER commit a real .env — see AGENTS.md security rules.

# Public URL of the deployment
# APP_URL=https://utils.lzhdev.com

# --- AI agent: runtime configuration, server-side only ----------------------
# An Anthropic-compatible endpoint is required by the existing Claude Agent SDK.
# Explicit endpoint/token/default are required. No provider/model fallback.
# ANTHROPIC_BASE_URL=https://token.sensenova.cn
# ANTHROPIC_AUTH_TOKEN=
# Existing deployments may keep SENSENOVA_API_KEY instead of ANTHROPIC_AUTH_TOKEN.
# If both are set, ANTHROPIC_AUTH_TOKEN takes precedence. No /v1 URL suffix.
# SENSENOVA_API_KEY=
# ANTHROPIC_MODEL=deepseek-flash
# Optional picker allowlist as a single-line JSON array; default must be in it.
# If omitted, only ANTHROPIC_MODEL is offered, with its ID as the display name.
# AI_MODELS='[{"id":"deepseek-flash","name":"DeepSeek V4.1 Flash"},{"id":"deepseek-v4-flash","name":"DeepSeek V4 Flash"},{"id":"sensenova-6.8-flash-lite","name":"SenseNova 6.8 Flash Lite"},{"id":"glm-5.2","name":"GLM-5.2"},{"id":"kimi-k3","name":"Kimi K3"}]'
# Optional auxiliary model overrides; absent slots follow the selected chat model.
# ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-flash
# ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-flash
# ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-flash

# --- Public accounts -------------------------------------------------------
# Set runtime secrets only in /opt/utils/.env (600); never send them in chat.
# DATABASE_PATH=/app/data/utils.sqlite
# BETTER_AUTH_SECRET=
# BREVO_API_KEY=
# MAIL_FROM=noreply@auth.lzhdev.com
# MAIL_FROM_NAME=lzhdev
# MAIL_REPLY_TO=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Only enable when host mapping is loopback-only behind Cloudflare Tunnel.
# TRUST_CLOUDFLARE_IP=1
# Public AI fails closed until an explicit quota policy is configured.
# AI_ENABLED=1
# AI_USER_DAILY_LIMIT=100
# AI_GLOBAL_DAILY_LIMIT=2000
