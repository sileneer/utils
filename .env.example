# Copy to .env for local runs (the server copy lives at /opt/utils/.env, chmod 600).
# NEVER commit a real .env — see AGENTS.md security rules.

# Public URL of the deployment (used for metadata/canonicals once wired up)
# APP_URL=https://utils.lzhdev.com

# --- M4: AI agent chat -------------------------------------------------------
# SenseNova (Anthropic-compatible) — https://platform.sensenova.cn/docs
# Server-side only. ANTHROPIC_BASE_URL must NOT have a /v1 suffix.
# SENSENOVA_API_KEY=
# ANTHROPIC_BASE_URL=https://token.sensenova.cn
# ANTHROPIC_MODEL=sensenova-6.8-flash-lite
# ANTHROPIC_DEFAULT_SONNET_MODEL=sensenova-6.8-flash-lite
# ANTHROPIC_DEFAULT_HAIKU_MODEL=sensenova-6.8-flash-lite
# ANTHROPIC_DEFAULT_OPUS_MODEL=sensenova-6.8-flash-lite
# Passcode gating the AI chat (family/shared secret)
# CHAT_PASSCODE=
